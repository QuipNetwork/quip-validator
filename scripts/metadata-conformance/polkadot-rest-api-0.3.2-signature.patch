+    #[test]
+    fn response_signature_preserves_composites_and_standard_enum_payloads() {
+        use parity_scale_codec::Encode;
+        use scale_info::{Registry, TypeInfo, meta_type};
+
+        #[derive(Encode, TypeInfo)]
+        struct CompositeSignature {
+            public: [u8; 3],
+            signature: [u8; 5],
+        }
+        #[derive(Encode, TypeInfo)]
+        enum StandardSignature {
+            Ed25519([u8; 64]),
+            Sr25519([u8; 64]),
+            Ecdsa([u8; 65]),
+        }
+        #[derive(Encode, TypeInfo)]
+        struct Wrapped(StandardSignature);
+
+        fn response<T: Encode + TypeInfo + 'static>(value: T) -> Vec<u8> {
+            let mut registry = Registry::new();
+            let ty = registry.register_type(&meta_type::<T>()).id;
+            signature_response_bytes(&value.encode(), ty, &registry.into()).to_vec()
+        }
+
+        // A leading 0, 1 or 2 in a composite is data, not a variant index.
+        for first in 0..=2 {
+            let value = CompositeSignature {
+                public: [first, 3, 4],
+                signature: [5; 5],
+            };
+            let expected = value.encode();
+            assert_eq!(response(value), expected);
+        }
+        assert_eq!(response(StandardSignature::Ed25519([3; 64])), vec![3; 64]);
+        assert_eq!(response(StandardSignature::Sr25519([4; 64])), vec![4; 64]);
+        assert_eq!(response(StandardSignature::Ecdsa([5; 65])), vec![5; 65]);
+        assert_eq!(
+            response(Wrapped(StandardSignature::Sr25519([6; 64]))),
+            vec![6; 64]
+        );
+        assert_eq!(response([0_u8; 64]), vec![0; 64]);
+
+        let metadata = std::sync::Arc::new(metadata());
+        let extrinsic =
+            DecodedExtrinsic::decode(2, bytes(V4_TRANSFER_ALLOW_DEATH), metadata).unwrap();
+        assert_eq!(
+            extrinsic.signature_response_bytes().unwrap(),
+            &extrinsic.signature_bytes().unwrap()[1..]
+        );
+    }
