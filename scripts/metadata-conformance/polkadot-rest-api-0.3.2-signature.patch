+/// Follow transparent wrappers only. Bound traversal so malformed recursive
+/// registries cannot loop; unknown shapes conservatively retain the full bytes.
+fn signature_response_bytes<'a>(
+    bytes: &'a [u8],
+    mut ty: u32,
+    types: &PortableRegistry,
+) -> &'a [u8] {
+    for _ in 0..types.types.len() {
+        let Some(resolved) = types.resolve(ty) else {
+            break;
+        };
+        match &resolved.type_def {
+            TypeDef::Variant(variants) => {
+                return if bytes.first().is_some_and(|index| {
+                    variants
+                        .variants
+                        .iter()
+                        .any(|variant| variant.index == *index)
+                }) {
+                    &bytes[1..]
+                } else {
+                    bytes
+                };
+            }
+            TypeDef::Composite(composite) if composite.fields.len() == 1 => {
+                ty = composite.fields[0].ty.id;
+            }
+            TypeDef::Tuple(tuple) if tuple.fields.len() == 1 => ty = tuple.fields[0].id,
+            _ => break,
+        }
+    }
+    bytes
+}
