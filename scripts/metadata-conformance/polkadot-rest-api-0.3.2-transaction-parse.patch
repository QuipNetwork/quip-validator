+        // Real Asset Hub body. Replace only its signature variant/payload; these
+        // synthetic signatures test parsing, not cryptographic verification.
+        let raw = hex::decode("bd01840072284f32719a49037a79da881b91b44bf642395ecba92b241619e21fb1c8a57a01b250abd5b7715a993a111d0db2f6742a8b108fd5a700b5c9e443f9fb14f79938d668ba315e48121b2bd2584b104014e6ede84fe35b77adcc9ff8030de5daef8ab4003e7b0100000000000000").unwrap();
+        let decoded = utils::decode_extrinsic_info(&raw, &metadata).unwrap();
+        let range = decoded.signature_payload().unwrap().signature_range();
+        let mut body = raw.as_slice();
+        Compact::<u32>::decode(&mut body).unwrap();
+        let prefix_len = raw.len() - body.len();
+        let original = parse_internal(
+            &client,
+            0,
+            ParseRequest {
+                tx: Some(hex::encode(&raw)),
+            },
+        )
+        .await
+        .unwrap()
+        .0;
+        assert_eq!(
+            original.signature.as_ref().unwrap().signature,
+            format!("0x{}", hex::encode(&raw[range.start + 1..range.end]))
+        );
+
+        for (variant, length) in [(0_u8, 64_usize), (1, 64), (2, 65)] {
+            let expected = vec![variant + 7; length];
+            let mut body = raw[prefix_len..range.start].to_vec();
+            body.push(variant);
+            body.extend_from_slice(&expected);
+            body.extend_from_slice(&raw[range.end..]);
+            let mut encoded = Compact(u32::try_from(body.len()).unwrap()).encode();
+            encoded.extend(body);
+            let response = parse_internal(
+                &client,
+                0,
+                ParseRequest {
+                    tx: Some(hex::encode(&encoded)),
+                },
+            )
+            .await
+            .unwrap()
+            .0;
+            assert!(response.is_signed);
+            let signature = response.signature.unwrap();
+            assert_eq!(signature.signature, format!("0x{}", hex::encode(expected)));
+            assert_eq!(
+                signature.signer.id,
+                original.signature.as_ref().unwrap().signer.id
+            );
+            assert_eq!(response.method.pallet, original.method.pallet);
