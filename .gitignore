# Rust workspace build output
/target/

# Keep Cargo.lock tracked for this workspace.

# rustfmt / editor backups
**/*.rs.bk
*.swp
*.swo
*~

# IDEs and editors
/.idea/
/.vscode/

# AI coding-assistant configs (AGENTS.md is the shared, checked-in version)
CLAUDE.md

# OS-generated files
.DS_Store
Thumbs.db

# Coverage / profiling output
*.profraw
*.profdata
/coverage/
/grcov/

# External repositories
polkadot-sdk

# Python
__pycache__
.pytest_cache/
*.egg-info/

# Per-operator key material produced by scripts/derive-operator-keys.sh.
# The script also writes a `*` .gitignore inside the directory; this entry
# is the outer guardrail in case the directory is moved or recreated.
/quip-testnet-keys/

# frame-benchmarking-cli scratch output. weights.rs is hand-written (custom formula plus
# provenance), so `benchmark pallet --output .../weights.rs` would destroy it. Benchmark
# here and hand-transfer the numbers instead.
scratch_weights.rs

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
